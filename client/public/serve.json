{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/apps",
      "destination": "/design/grubshelf",
      "type": 301
    },
    {
      "source": "/design",
      "destination": "/products",
      "type": 301
    },
    {
      "source": "/design/grubshelf/screens",
      "destination": "/design/grubshelf",
      "type": 301
    }
  ],
  "headers": [
    {
      "source": "assets/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "fonts/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "{images,videos,icons}/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
